---
import avatar from '../assets/avatar-new.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
import EthLogo from './EthLogo.astro';
import Portrait from './Portrait.astro';
import ProjectList from './ProjectList.astro';
const [jobTitle, studyTitle] = site.role.split(' and ');
const [jobRole, workplace] = jobTitle.split(' @ ');
---
<BaseLayout title={`${site.author} | bruol`} description={site.description} image={avatar.src} variant={8} landing>
  <div class="portfolio">
    <header class="masthead"><a href="/" class="wordmark">bruol</a></header>
    <main id="main">
      <section class="profile" aria-labelledby="name">
        <h1 id="name">{site.author}</h1>
        <Portrait />
        <p class="role">
          <span class="role-line">{studyTitle.replace(/ @ ETH Zurich$/, '')}<span class="institution"> @ <a class="eth-link" href="https://ethz.ch/en.html" aria-label="ETH Zurich"><EthLogo /></a></span></span>
          <span class="role-line">{jobRole} @ <a href="https://ces.ethz.ch/">{workplace}</a></span>
          <span class="role-line"><a href={site.teachingRole.href}>{site.teachingRole.title}</a><span class="institution"> @ <a class="eth-link" href="https://ethz.ch/en.html" aria-label="ETH Zurich"><EthLogo /></a></span></span>
        </p>
        <nav class="social-links" aria-label="Social links">
          {site.socialLinks.map(link => <a href={link.href} rel="me">{link.label}</a>)}
        </nav>
        <nav class="actions" aria-label="More about Lorin">
          <a href={site.cvUrl}>CV</a>
        </nav>
      </section>
      <ProjectList />
    </main>
    <footer class="portfolio-footer">
      <span>© 2026 bruol</span>
    </footer>
  </div>
</BaseLayout>
