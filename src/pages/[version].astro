---
import BrutalistHome from '../components/BrutalistHome.astro';
export function getStaticPaths() {
  return Array.from({ length: 10 }, (_, index) => index + 1).map(variant => ({ params: { version: String(variant) }, props: { variant } }));
}
const { variant } = Astro.props;
---
<BrutalistHome variant={variant} />
