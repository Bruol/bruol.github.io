---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
import { fonts } from '../data/fonts.js';
const { fontIndex = 0 } = Astro.props;
const font = fonts[fontIndex];
---
<BaseLayout title={`${site.author} | bruol`} description={site.description} variant={7} landing>
  <div class="portfolio" style={`--profile-font: "${font.family}", Arial, sans-serif;`}>
    <header class="masthead"><a href="/" class="wordmark">bruol</a></header>
    <main id="main">
      <section class="profile" aria-labelledby="name">
        <Image
          src={avatar}
          alt="Lorin Urbantat"
          width={300}
          height={300}
          widths={[160, 190, 240, 300, 380, 480, 600]}
          sizes="(max-width: 700px) 160px, 240px"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          class="portrait"
        />
        <div class="profile-info">
          <h1 id="name">{site.author}</h1>
          <p class="role">{site.role}</p>
          <nav class="social-links" aria-label="Social links">
            {site.socialLinks.map(link => <a href={link.href} rel="me">{link.label}</a>)}
          </nav>
          <nav class="actions" aria-label="More about Lorin">
            <a href={site.cvUrl}>CV</a>
          </nav>
        </div>
      </section>
    </main>
    <footer class="portfolio-footer">
      <span>© 2026 bruol</span>
      <nav class="version-nav" aria-label="Font versions">
        {fonts.map((item, index) => <a href={`/${index + 1}/`} aria-current={fontIndex === index ? 'page' : undefined} aria-label={`Font ${index + 1}: ${item.name}`}>{item.name}</a>)}
      </nav>
    </footer>
  </div>
</BaseLayout>
