---
import { hobbies } from '../data/site.js';
const { marathon, ride, strava, workouts, lifts } = hobbies;
// Monochrome 24px stroke icons; they inherit the label colour.
const icons = {
  stopwatch: '<circle cx="12" cy="14" r="7"/><path d="M12 14v-4M10 3h4M12 3v4M18 7l1.5-1.5"/>',
  bike: '<circle cx="5.5" cy="16.5" r="3.5"/><circle cx="18.5" cy="16.5" r="3.5"/><path d="M5.5 16.5 9 9h7l2.5 7.5M9 9l3.5 7.5H16M14 5h3l-1 4"/>',
  flame: '<path d="M12 3c.5 4 6 6 6 11a6 6 0 0 1-12 0c0-3 2-4.5 2-7 1.5 1 2.5 2.5 2.5 4 1.5-2 1.5-5 1.5-8z"/>',
  calendar: '<rect x="3" y="5" width="18" height="16"/><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4"/>',
  dumbbell: '<path d="M6 7v10M18 7v10M3 10v4M21 10v4M6 12h12"/>'
};
---
<section class="hobbies" aria-label="Hobbies">
  <dl class="hobbies-stats">
    <div><dt><svg class="hobby-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.stopwatch} />Marathon</dt><dd>{marathon.time}</dd></div>
    <div><dt><svg class="hobby-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.bike} />Longest ride</dt><dd><a href={ride.href} rel="noopener" title={`${ride.km} km, ${ride.elevation} climbing on Strava`}>{ride.km} km ↗</a></dd></div>
    <div><dt><svg class="hobby-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.flame} />Strava streak</dt><dd>{strava.weeks} wk</dd></div>
    <div><dt><svg class="hobby-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.calendar} />Gym sessions</dt><dd>{workouts}</dd></div>
    {lifts.map((lift) => (
      <div><dt><svg class="hobby-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.dumbbell} />{lift.name}</dt><dd>{lift.kg} kg × {lift.reps}</dd></div>
    ))}
  </dl>
</section>

<script is:inline>
  {
    // Pin the stats to the bottom right of the first screen when that corner
    // is empty; otherwise leave them in flow below the profile.
    const box = document.querySelector('.hobbies');
    const profile = document.querySelector('.opening-view .profile');
    const textRect = (el) => {
      const range = document.createRange();
      range.selectNodeContents(el);
      return range.getBoundingClientRect();
    };
    const place = () => {
      box.classList.remove('at-screen-edge');
      if (window.innerWidth <= 700) return;
      const top = window.innerHeight - box.offsetHeight - 16;
      const right = document.documentElement.clientWidth - 24;
      const left = right - box.offsetWidth;
      const blockers = [
        ...profile.querySelectorAll('h1, .portrait, .social-links a, .actions a'),
      ].map((el) => el.getBoundingClientRect())
        .concat([...profile.querySelectorAll('.role-line')].map(textRect));
      const clear = blockers.every((r) =>
        r.bottom + window.scrollY + 24 <= top || r.right + 32 <= left);
      if (!clear) return;
      box.style.setProperty('--hobbies-top', `${top}px`);
      box.classList.add('at-screen-edge');
    };
    place();
    document.fonts.ready.then(() => {
      place();
      new ResizeObserver(place).observe(profile);
    });
    window.addEventListener('resize', place, { passive: true });
    window.addEventListener('pageshow', place);
  }
</script>

<style>
  .hobbies { align-self: flex-end; width: max-content; max-width: 100%; margin-top: 40px; }
  .hobbies.at-screen-edge { position: absolute; top: var(--hobbies-top); right: 24px; margin: 0; }
  .hobbies-stats { margin: 0; display: grid; grid-template-columns: repeat(4, max-content); gap: 10px 32px; }
  .hobbies-stats dt {
    display: flex; align-items: center; gap: 5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .68rem; font-weight: 400; color: #555; line-height: 1.3;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .hobby-icon { flex: none; width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) {
    .hobbies { opacity: .4; transition: opacity 160ms ease; }
    .hobbies:hover, .hobbies:focus-within { opacity: 1; }
  }
  .hobbies-stats dd { margin: 0; padding-left: 18px; font-size: 16px; line-height: 1.25; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hobbies-stats dd a:hover { color: var(--link-accent); }
  @media (max-width: 700px) {
    .hobbies { width: 100%; }
    .hobbies-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
