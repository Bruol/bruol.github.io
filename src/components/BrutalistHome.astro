---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
const { variant = 1 } = Astro.props;
---
<BaseLayout title={`${site.author} | bruol`} description={site.description} variant={variant} landing>
  <div class="portfolio">
    <header class="masthead"><a href="/" class="wordmark">bruol</a></header>
    <main id="main">
      <section class="profile" aria-labelledby="name">
        <Image
          src={avatar}
          alt="Lorin Urbantat"
          width={300}
          height={300}
          widths={[160, 190, 240, 300, 380, 480, 600]}
          sizes={variant === 5 ? "(max-width: 700px) 160px, 340px" : variant === 4 ? "(max-width: 700px) 160px, 210px" : "(max-width: 700px) 160px, 190px"}
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          class="portrait"
        />
        <div class="profile-info">
          <h1 id="name">{site.author}</h1>
          <p class="role">{site.role}</p>
          <nav class="social-links" aria-label="Social links">
            {site.socialLinks.map(link => <a href={link.href} rel="me">{link.label}</a>)}
          </nav>
          <nav class="actions" aria-label="More about Lorin">
            <a href={site.cvUrl}>CV</a>
            <a href="/blog/">Projects & writing</a>
          </nav>
        </div>
      </section>
    </main>
    <footer class="portfolio-footer">
      <span>© 2026 bruol</span>
      <nav class="version-nav" aria-label="Design versions">
        {[1, 2, 3, 4, 5].map(number => <a href={`/${number}/`} aria-current={variant === number ? 'page' : undefined} aria-label={`Version ${number}`}>{number}</a>)}
      </nav>
    </footer>
  </div>
</BaseLayout>
