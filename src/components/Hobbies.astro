---
import { hobbies } from '../data/site.js';
const { marathon, strava, workouts, lifts, updated } = hobbies;
---
<section class="hobbies" aria-labelledby="hobbies-title">
  <h2 id="hobbies-title" class="hobbies-title">Hobbies <span>· as of {updated}</span></h2>
  <dl class="hobbies-stats">
    <div><dt>Marathon</dt><dd>{marathon.time} <span>{marathon.race}</span></dd></div>
    <div><dt>Strava streak</dt><dd>{strava.weeks} weeks <span>{strava.activities} activities</span></dd></div>
    {lifts.map((lift) => (
      <div><dt>{lift.name}</dt><dd>{lift.kg} kg × {lift.reps}</dd></div>
    ))}
    <div><dt>Gym sessions</dt><dd>{workouts} <span>logged on Hevy</span></dd></div>
  </dl>
</section>

<style>
  .hobbies { margin-left: auto; width: min(100%, 340px); border-top: 1px solid #000; padding-top: 12px; }
  .hobbies-title {
    margin: 0 0 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .75rem; font-weight: 700; letter-spacing: .035em; text-transform: uppercase;
  }
  .hobbies-title span, .hobbies-stats dd span { color: #555; font-weight: 400; }
  .hobbies-stats { margin: 0; display: grid; gap: 4px; font-size: 13px; line-height: 1.4; }
  .hobbies-stats div { display: flex; justify-content: space-between; gap: 16px; }
  .hobbies-stats dt { font-weight: 400; }
  .hobbies-stats dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
