<div class="scroll-cue">
  <span class="cue-projects">Projects</span>
</div>
<script is:inline>
  {
    const cue = document.querySelector('.scroll-cue');
    const profile = document.querySelector('.opening-view .profile');
    const updateEdge = () => {
      const profileBottom = profile.getBoundingClientRect().bottom + window.scrollY;
      const fits = window.innerWidth > 700 && window.innerHeight > 600 &&
        profileBottom + 64 <= window.innerHeight;
      cue.classList.toggle('at-screen-edge', fits);
      cue.style.setProperty('--cue-edge', `${window.innerHeight}px`);
    };
    updateEdge();
    document.fonts.ready.then(() => {
      updateEdge();
      const observer = new ResizeObserver(updateEdge);
      observer.observe(profile);
      const masthead = document.querySelector('.masthead');
      if (masthead) observer.observe(masthead);
    });
    window.addEventListener('resize', updateEdge, { passive: true });
    window.addEventListener('pageshow', updateEdge);
  }
</script>

<style>
  .scroll-cue {
    margin-top: auto;
    padding-top: 32px;
  }
  .cue-projects {
    display: block;
    width: max-content;
    color: var(--link-accent);
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.025em;
  }
  .at-screen-edge {
    position: absolute;
    top: var(--cue-edge, 100svh);
    left: 24px;
    padding-top: 0;
    height: 0;
  }
  .at-screen-edge .cue-projects {
    /* Leave a little breathing room above the viewport’s bottom edge. */
    transform: translateY(calc(-100% - 16px));
  }
</style>
