---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectFacts from '../../components/ProjectFacts.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, image } = project.data;
// Lead image beside the story, unless the article already shows it.
const heroImage = !project.data.demo && image && !project.body?.includes(image) ? image : undefined;
---

<BaseLayout title={`${title} | Projects | bruol`} description={description} image={image}>
  <article class="project-page">
    <div class="project-story">
      <a class="project-back" href="/#projects">All projects</a>
      <h1>{title}</h1>
      <p class="project-lede">{description}</p>
      <div class="project-prose"><Content /></div>
      <p class="project-end"><a href="/#projects">Back to all projects</a></p>
    </div>
    <aside class="project-panel">
      <ProjectFacts project={project} />
      <ProjectMedia project={project} heroImage={heroImage} />
    </aside>
  </article>
</BaseLayout>
