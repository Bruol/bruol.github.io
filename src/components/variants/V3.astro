---
// Version 3, "Split": the story scrolls on the left while the right column holds
// still — the demo (or image) plus the facts, set large.
import HeroMedia from './HeroMedia.astro';
import Facts from './Facts.astro';
const { project, heroImage, builtWith } = Astro.props;
const { title, description } = project.data;
---
<article class="v3">
  <div class="v3-story">
    <a class="v-back" href="/#projects">All projects</a>
    <h1>{title}</h1>
    <p class="v3-lede">{description}</p>
    <div class="project-prose"><slot /></div>
    <p class="v3-end"><a href="/#projects">Back to all projects</a></p>
  </div>
  <aside class="v3-panel">
    <div class="v3-panel-inner">
      <HeroMedia project={project} heroImage={heroImage} />
      <Facts project={project} builtWith={builtWith} class="v3-facts" />
    </div>
  </aside>
</article>

<style is:global>
  .v3 { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 5vw, 88px); max-width: 1440px; margin: 0 auto; align-items: start; }
  .v3-story { max-width: 620px; justify-self: end; width: 100%; }
  .v3 h1 { margin: 32px 0 28px; font-size: clamp(48px, 6vw, 96px); font-weight: 900; line-height: .95; letter-spacing: -.055em; overflow-wrap: anywhere; }
  .v3-lede { margin: 0 0 40px; font-size: clamp(22px, 2vw, 28px); font-weight: 700; line-height: 1.22; letter-spacing: -.025em; }
  .v3 .project-prose { font-size: 18px; line-height: 1.65; }
  .v3-end { margin-top: 64px; font-size: 18px; font-weight: 700; }
  .v3-end a { color: var(--link-accent); text-decoration-line: underline; text-underline-offset: 4px; }
  .v3-panel { position: sticky; top: 24px; margin-top: 64px; }
  .v3-panel .project-demo, .v3-panel .hero-image { margin: 0 0 40px; }
  .v3-panel .hero-image img { display: block; width: 100%; max-height: 70vh; object-fit: contain; background: #f2f2f2; border: 1px solid #000; }
  .v3-panel .project-demo figcaption { text-align: left; margin-inline: 0; }
  .v3-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 40px; margin: 0; padding: 28px 0 0; border-top: 1px solid #000; }
  .v3-facts dd { font-size: clamp(20px, 2vw, 30px); letter-spacing: -.025em; line-height: 1.15; }
  .v3-facts .facts-links { font-size: 20px; }
  /* Text-only projects: the facts fill the panel at poster scale. */
  .v3-panel-inner:not(:has(.project-demo, .hero-image)) .v3-facts { grid-template-columns: 1fr; padding: 32px; border: 0; background: var(--link-accent); color: #000; }
  .v3-panel-inner:not(:has(.project-demo, .hero-image)) .v3-facts dt { color: #000; }
  .v3-panel-inner:not(:has(.project-demo, .hero-image)) .v3-facts dd { font-size: clamp(26px, 3vw, 44px); }
  .v3-panel-inner:not(:has(.project-demo, .hero-image)) .facts-links a { color: #fff; text-decoration-color: #fff; }
  @media (max-width: 960px) {
    .v3 { display: flex; flex-direction: column; gap: 0; }
    .v3-story { display: contents; }
    .v3 .v-back { order: 1; align-self: flex-start; }
    .v3 h1 { order: 2; }
    .v3-lede { order: 3; }
    .v3-panel { order: 4; position: static; margin: 0 0 40px; }
    .v3 .project-prose { order: 5; font-size: 17px; }
    .v3-end { order: 6; }
  }
  @media (max-width: 520px) { .v3-facts { grid-template-columns: 1fr; } }
</style>
