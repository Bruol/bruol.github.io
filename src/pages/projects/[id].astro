---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { title, description, category, role, period, tags, image, imageAlt, links } = project.data;
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={`${title} | Projects | bruol`} description={description} image={image}>
  <article class="project-article">
    <a class="project-back" href="/projects/">← All projects</a>
    <header class="project-heading">
      <p class="project-eyebrow">{category}{period && ` · ${period}`}</p>
      <h1>{title}</h1>
      <p class="project-lede">{description}</p>
      <p class="project-role">{role}</p>
      <ul class="project-tags" aria-label="Technologies and topics">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
      {links.length > 0 && <nav class="project-links" aria-label="Project resources">
        {links.map((link) => <a href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}
      </nav>}
    </header>
    <div class="project-reading-layout">
      {sections.length > 1 && <aside class="project-toc">
        <nav aria-label="On this page">
          <p>On this page</p>
          <ul>{sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
        </nav>
      </aside>}
      <div class="project-prose"><Content /></div>
    </div>
    <footer class="project-end"><a href="/projects/">← Explore the other projects</a></footer>
  </article>
</BaseLayout>
